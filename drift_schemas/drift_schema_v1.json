  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL CHECK(\"type\" IN ('expense', 'income')), \"icon_key\" TEXT NOT NULL, \"color_key\" TEXT NOT NULL, \"limit_minor\" INTEGER NULL CHECK(\"limit_minor\" >= 0), \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, UNIQUE (name COLLATE NOCASE, type));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"amount_minor\" INTEGER NOT NULL CHECK(\"amount_minor\" > 0), \"type\" TEXT NOT NULL CHECK(\"type\" IN ('expense', 'income')), \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"occurred_at\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"note\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "notifications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notifications\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"body\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"read_at\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"preferences\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
