  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL CHECK(\"type\" IN ('expense', 'income')), \"icon_key\" TEXT NOT NULL, \"color_key\" TEXT NOT NULL, \"limit_minor\" INTEGER NULL CHECK(\"limit_minor\" >= 0), \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, UNIQUE (name COLLATE NOCASE, type));"
        }
      ]
    },
    {
      "name": "bills",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bills\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL CHECK(\"amount_minor\" > 0), \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"repeat_unit\" TEXT NOT NULL CHECK(\"repeat_unit\" IN ('day', 'week', 'month', 'year')), \"repeat_every\" INTEGER NOT NULL CHECK(\"repeat_every\" >= 1), \"repeat_day\" INTEGER NULL CHECK(\"repeat_day\" BETWEEN 1 AND 31), \"next_due\" TEXT NOT NULL, \"remind_days_before\" INTEGER NULL CHECK(\"remind_days_before\" >= 0), \"icon_key\" TEXT NOT NULL DEFAULT 'bolt', \"color_key\" TEXT NOT NULL DEFAULT 'yellow', \"paused\" INTEGER NOT NULL DEFAULT 0 CHECK (\"paused\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"amount_minor\" INTEGER NOT NULL CHECK(\"amount_minor\" > 0), \"type\" TEXT NOT NULL CHECK(\"type\" IN ('expense', 'income')), \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"occurred_at\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"note\" TEXT NULL, \"bill_id\" INTEGER NULL REFERENCES bills (id) ON DELETE SET NULL);"
        }
      ]
    },
    {
      "name": "notifications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notifications\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"body\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"read_at\" TEXT NULL, \"category_id\" INTEGER NULL REFERENCES categories (id) ON DELETE SET NULL);"
        }
      ]
    },
    {
      "name": "preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"preferences\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "goals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goals\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"icon_key\" TEXT NOT NULL, \"target_minor\" INTEGER NOT NULL CHECK(\"target_minor\" > 0), \"target_month\" TEXT NOT NULL, \"completed_at\" TEXT NULL, \"created_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "goal_contributions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goal_contributions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"goal_id\" INTEGER NOT NULL REFERENCES goals (id) ON DELETE CASCADE, \"amount_minor\" INTEGER NOT NULL CHECK(NOT (\"amount_minor\" = 0)), \"label\" TEXT NOT NULL, \"date\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "period_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"period_snapshots\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"period_start\" TEXT NOT NULL UNIQUE, \"period_end\" TEXT NOT NULL, \"budget_minor\" INTEGER NULL CHECK(\"budget_minor\" >= 0), \"spent_minor\" INTEGER NOT NULL CHECK(\"spent_minor\" >= 0), \"income_minor\" INTEGER NOT NULL CHECK(\"income_minor\" >= 0));"
        }
      ]
    },
    {
      "name": "period_snapshot_limits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"period_snapshot_limits\" (\"snapshot_id\" INTEGER NOT NULL REFERENCES period_snapshots (id) ON DELETE CASCADE, \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE CASCADE, \"limit_minor\" INTEGER NOT NULL CHECK(\"limit_minor\" >= 0), PRIMARY KEY (\"snapshot_id\", \"category_id\"));"
        }
      ]
